# ===========================================
# Production Environment Template
# ===========================================
# Copy to .env.production and fill with production values

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (Use managed service in production)
DATABASE_URL="postgresql://username:password@host:5432/dojocountdown?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=dojocountdown

# JWT Configuration (MUST CHANGE IN PRODUCTION!)
JWT_ACCESS_SECRET="CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-MIN-32-CHARS"
JWT_REFRESH_SECRET="CHANGE-THIS-TO-A-DIFFERENT-SECURE-RANDOM-STRING-MIN-32-CHARS"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security
BCRYPT_SALT_ROUNDS=12

# Rate Limiting (Adjust based on traffic)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration (Update with your frontend domain)
CORS_ORIGIN="https://yourdomain.com"

# Optional: API Port
API_PORT=3000

# Production Tips:
# - Use a managed PostgreSQL service (RDS, Cloud SQL, etc.)
# - Store secrets in a secret manager (AWS Secrets Manager, HashiCorp Vault)
# - Enable SSL/TLS for database connections
# - Use environment-specific configs
# - Set up monitoring and logging
# - Configure backups
